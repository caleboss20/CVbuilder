# Copy this file to .env.local and fill in the values. .env.local is never committed.
# Add the same two values in Vercel under Project Settings > Environment Variables.

# Supabase: Project Settings > API. Both are safe to expose in the browser.
# Never put the service_role key or the database password in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: support WhatsApp number, digits only with the country code
# NEXT_PUBLIC_WHATSAPP=233256599734
