# Copy this file to .env.local and fill in the values. .env.local is never committed.
# Add the same two values in Vercel under Project Settings > Environment Variables.

# Supabase: Project Settings > API. Both are safe to expose in the browser.
# Never put the service_role key or the database password in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: support WhatsApp number, digits only with the country code
# NEXT_PUBLIC_WHATSAPP=233256599734

# AI (server only, never prefix with NEXT_PUBLIC_). Create a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# "admin" (default) while testing, "everyone" once credits and payments exist
# AI_ACCESS=admin

# Payments (Paystack). Test keys first: Paystack dashboard > Settings > API Keys. All server only.
# PAYSTACK_SECRET_KEY=sk_test_...
# After running supabase/payments.sql, copy pay_settings.confirm_secret from Supabase into this:
# PAYMENT_CONFIRM_SECRET=
# Turn the paywall on for students (also controls every "free" claim on the site). Leave unset until all of the above works.
# NEXT_PUBLIC_PAYMENTS_ENABLED=true
